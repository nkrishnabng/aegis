# --- Backend ---
# Required. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-sonnet-5 (cheaper/faster, good for high-volume
# test generation and execution). Use claude-opus-4-8 for the most capable
# model on complex flows, or claude-haiku-4-5 for the lowest cost.
ANTHROPIC_MODEL=claude-sonnet-5

# SQLite by default (zero config). To use Postgres instead, set e.g.
# postgresql://user:password@localhost:5432/testautomation and update
# packages/backend/prisma/schema.prisma datasource provider to "postgresql".
DATABASE_URL="file:./prisma/dev.db"

# Port the backend REST + WebSocket server listens on.
PORT=4000

# Playwright MCP launch options.
# Set to "false" to watch the browser while the agent works (useful for demos/debugging).
PLAYWRIGHT_HEADLESS=true
# chrome | firefox | webkit | msedge
PLAYWRIGHT_BROWSER=chromium

# Directory (relative to packages/backend) where screenshots are written.
SCREENSHOTS_DIR=./data/screenshots

# Directory (relative to packages/backend) where per-session Playwright MCP
# trace/video/storage-state files are written (served at /artifacts/*).
ARTIFACTS_DIR=./data/mcp-artifacts

# Optional. POSTed with a JSON payload (a top-level "text" field makes this a
# drop-in Slack incoming webhook URL) whenever a test run finishes with a
# non-passed status. Leave empty to disable.
WEBHOOK_URL=

# Origin allowed to call the API with credentials (cookies). Must match exactly
# where the frontend is served from.
FRONTEND_ORIGIN=http://localhost:3000

# Required for the login gate. Set once, then run `npm run seed` to create the
# first user -- after that, credentials are only stored as a password hash.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Required. Symmetric key used to encrypt environment credentials at rest
# (AES-256-GCM). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# Max number of test cases executed concurrently by "Run all".
MAX_PARALLEL_RUNS=3

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:4000
